{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-portfolio.example/schemas/evaluation-result.schema.json",
  "title": "AI Agent Evaluation Result",
  "description": "Shared evaluation result contract for the Python, LangChain, and Rust AI agent implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_run_id",
    "run_status",
    "implementation",
    "dataset",
    "execution",
    "summary",
    "metrics",
    "results"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "evaluation_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "dataset": {
      "$ref": "#/$defs/dataset"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "environment": {
      "$ref": "#/$defs/environment"
    }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_id",
        "language",
        "framework"
      ],
      "properties": {
        "implementation_id": {
          "type": "string",
          "enum": [
            "ai-agent-py",
            "ai-agent-lc",
            "ai-agent-rs"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "python",
            "rust"
          ]
        },
        "framework": {
          "type": "string",
          "enum": [
            "plain-python",
            "langchain-langgraph",
            "rustview"
          ]
        },
        "application_version": {
          "type": "string"
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "dataset_version",
        "task",
        "total_cases"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_version": {
          "type": "string",
          "minLength": 1
        },
        "task": {
          "type": "string",
          "enum": [
            "ticket_classification",
            "tool_selection",
            "policy_compliance",
            "adversarial_resilience",
            "response_quality",
            "integration",
            "regression"
          ]
        },
        "total_cases": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "duration_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        },
        "git_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "configuration_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "passed",
        "failed",
        "errors",
        "skipped"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "classification_macro_f1": {
          "$ref": "#/$defs/rate"
        },
        "entity_field_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "entity_exact_match": {
          "$ref": "#/$defs/rate"
        },
        "tool_selection_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "invalid_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "policy_decision_accuracy": {
          "$ref": "#/$defs/rate"
        },
        "policy_bypasses": {
          "type": "integer",
          "minimum": 0
        },
        "approval_bypasses": {
          "type": "integer",
          "minimum": 0
        },
        "response_quality_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 5
        },
        "evidence_support_rate": {
          "$ref": "#/$defs/rate"
        },
        "sensitive_data_exposures": {
          "type": "integer",
          "minimum": 0
        },
        "safe_failure_rate": {
          "$ref": "#/$defs/rate"
        },
        "output_schema_validity_rate": {
          "$ref": "#/$defs/rate"
        },
        "policy_decision_parity": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "status",
        "expected",
        "actual",
        "checks"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "ERROR",
            "SKIPPED"
          ]
        },
        "expected": {
          "type": "object"
        },
        "actual": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "failure": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failure"
            }
          ]
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "name",
        "passed"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "passed": {
          "type": "boolean"
        },
        "expected": {},
        "actual": {}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_code",
        "severity",
        "message"
      ],
      "properties": {
        "failure_code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "INFO",
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtime_version": {
          "type": "string"
        },
        "operating_system": {
          "type": "string"
        },
        "environment_name": {
          "type": "string",
          "enum": [
            "local",
            "ci",
            "staging"
          ]
        }
      }
    }
  }
}
